# ---- Smart CV tailoring. Set ONE of these. Without either, template tailoring is used. ----
# Gemini (free tier at https://aistudio.google.com/apikey) -- recommended:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Or Anthropic Claude (paid):
ANTHROPIC_API_KEY=
RAG_TAILOR_MODEL=claude-sonnet-4-6

# ---- Optional: daily email digest (Gmail). ----
# Create a Gmail App Password: Google Account -> Security -> 2-Step Verification -> App passwords.
GMAIL_USER=you@example.com
GMAIL_APP_PASSWORD=
DIGEST_TO=you@example.com
DIGEST_MIN_SCORE=45
APP_URL=http://127.0.0.1:8077
